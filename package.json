{
  "name": "ecomzone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server/custom-server.ts",
    "build": "npx prisma generate && next build",
    "start": "ts-node --project tsconfig.server.json server/custom-server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --project tsconfig.server.json prisma/seed.ts",
    "db:seed-admin": "ts-node --project tsconfig.server.json prisma/seed-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.56.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "multer": "^2.1.1",
    "next": "16.1.6",
    "nodemailer": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "razorpay": "^2.9.6",
    "pino": "^8.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.22.4",
    "ts-node": "^10.9.1",
    "typescript": "^5",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4"
  }
}
